# BasicFlagFlow

main: kit: flow: BasicFlagFlow:
{
  entity: "flag",
  kind: "basic",
  name: "BasicFlagFlow",
  step: [
    {
      i: {
        ref: "flag_ref01"
      }

      m: {
        account_id: "account01",
        app_id: "app01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01",
        app_id: "app01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "flag_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01",
        app_id: "app01"
      }

      i: {
        ref: "flag_ref01",
        srcdatavar: "flag_ref01_data",
        suffix: "_up0",
        textfield: "default_variation"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-flag_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "flag_ref01",
        srcdatavar: "flag_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        app_id: "app01",
        id: "flag01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-flag_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "flag_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        app_id: "app01",
        id: "flag01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01",
        app_id: "app01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "flag_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicFlagFlow"
}