# API Information


main: {
  kit: {
    info: {
      description: "Cloudflare developer platform services: artifacts, feature flags, bulk operations, snippets, and platform readiness endpoints."
      license: {
        name: "BSD-3-Clause"
        url: "https://opensource.org/licenses/BSD-3-Clause"
      }
      security: {
        in: "header"
        name: "X-Auth-Email"
        prefix: ""
        scheme: "api_email"
        type: "apiKey"
      }
      servers: [
        {
          description: "Client API"
          url: "https://api.cloudflare.com/client/v4"
        }
      ]
      summary: "Cloudflare developer platform services: artifacts, feature flags, bulk operations, snippets, and platform readiness endpoints."
      title: "Cloudflare Developer Platform"
      version: "4.0.0"
      website: "https://cloudflare.com"
    }
  }
}

